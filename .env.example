# LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional: API request timeout in seconds (default: 30)
# ASC_REQUEST_TIMEOUT=30

# Integration tests (optional)
TEST_APP_ID=123456789
TEST_PRODUCT_ID=com.example.weekly
