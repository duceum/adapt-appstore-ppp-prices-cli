ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_PRIVATE_KEY_PATH=AuthKey_XXXX.p8
LLM_API_KEY=sk-...

# Any OpenAI-compatible provider works: OpenRouter, Groq, Together, DeepSeek,
# or a local Ollama / LM Studio / vLLM. Leave both unset for OpenAI itself.
