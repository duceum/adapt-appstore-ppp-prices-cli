# App Store Connect API key with pricing permissions. Required.
# Create one at https://appstoreconnect.apple.com/access/integrations/api
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_PRIVATE_KEY_PATH=AuthKey_XXXX.p8

# Optional: App Store Connect request timeout in seconds (default: 30)
# ASC_REQUEST_TIMEOUT=30

# AI analysis. Optional -- without a key the GDP-based coefficients are used,
# which are perfectly usable on their own.
LLM_API_KEY=sk-...
LLM_MODEL=gpt-5.2

# Any OpenAI-compatible endpoint works: OpenRouter, Groq, Together, Fireworks,
# DeepSeek, or a local Ollama / LM Studio / vLLM. Uncomment both, and put that
# provider's key in LLM_API_KEY above. A local model needs no real key, but the
# variable still has to be set to something.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional: LLM request timeout in seconds (default: 120). Raise it for slow
# local models.
# LLM_REQUEST_TIMEOUT=120

# Integration tests (optional)
TEST_APP_ID=123456789
TEST_PRODUCT_ID=com.example.weekly
